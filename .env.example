# ==============================================================================
# CineVerse TMDB API Configuration Template
# ==============================================================================
# Instructions:
# 1. Sign up for a free TMDB account at https://www.themoviedb.org
# 2. Go to Settings > API and generate an API Read Access Token (v4 auth Bearer token)
# 3. Copy this file to .env and fill in your token:
#    cp .env.example .env
# 4. In development, you can also test or update your token directly in the app
#    under the "Settings" tab > "TMDB API Connectivity".
# ==============================================================================

TMDB_BEARER_TOKEN=your_tmdb_v4_read_access_token_here
TMDB_API_KEY=your_tmdb_v3_api_key_here
